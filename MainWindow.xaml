<Window x:Class="KVANTLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KVANTLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="KVANT Launcher" Height="580" Width="850"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#18181b">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Стили для контролов (Dark Theme) -->
        
        <!-- Стиль текстового поля -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#f4f4f5"/>
            <Setter Property="CaretBrush" Value="#f4f4f5"/> 
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style Toggle Switch (CheckBox) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#d4d4d8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Track (pill background) -->
                            <Border x:Name="Track"
                                    Width="46" Height="26"
                                    CornerRadius="13"
                                    Background="#3f3f46"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                                <!-- Thumb (circle) -->
                                <Grid>
                                    <Ellipse x:Name="Thumb"
                                             Width="20" Height="20"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                        </Ellipse.Effect>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <!-- Label -->
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#10b981" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#3f3f46" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Хай-тек Зеленая кнопка -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#059669"/> <!-- Emerald-600 -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10b981"/> <!-- Emerald-500 -->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#064e3b"/> <!-- Emerald-900 -->
                                <Setter Property="Foreground" Value="#34d399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вторичной кнопки (для настроек) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272a"/>
                                <Setter Property="Foreground" Value="#10b981"/>
                                <Setter Property="BorderBrush" Value="#10b981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль кнопки выбора скина (Premium Photo Style) -->
        <Style x:Key="SkinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Container" Cursor="Hand" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <!-- Outer Glow Border -->
                            <Border x:Name="OuterGlow" 
                                    Width="52" Height="52" 
                                    CornerRadius="14" 
                                    BorderBrush="#10b981" 
                                    BorderThickness="1.5"
                                    Background="#18181b">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10b981" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>

                            <!-- Background Pattern/Placeholder -->
                            <Border x:Name="InternalBg" 
                                    Width="48" Height="48" 
                                    CornerRadius="12" 
                                    Background="#27272a"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Анимированный векторный шлем (fallback) -->
                                    <Grid x:Name="HelmetIcon" Opacity="0.7">
                                        <Border Width="24" Height="18" 
                                                Background="#18181b" 
                                                CornerRadius="12,12,3,3" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                                <Border Width="6" Height="2" Background="#10b981" CornerRadius="1" Margin="1,0"/>
                                                <Border Width="6" Height="2" Background="#10b981" CornerRadius="1" Margin="1,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Реальное изображение скина (Фото) -->
                                    <Image x:Name="Img" 
                                           Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" 
                                           Stretch="Uniform"
                                           Margin="6"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    </Image>
                                    
                                    <!-- Glossy Overlay -->
                                    <Border CornerRadius="12" Opacity="0.1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="0.5"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Hidden ContentPresenter -->
                            <ContentPresenter Visibility="Collapsed"/>

                            <!-- Green Edit Badge (+) -->
                            <Border Width="22" Height="22" 
                                    Background="#10b981" 
                                    CornerRadius="11" 
                                    VerticalAlignment="Bottom" 
                                    HorizontalAlignment="Right"
                                    Margin="0,0,-2,-2"
                                    BorderBrush="#18181b"
                                    BorderThickness="2">
                                <TextBlock Text="+" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterGlow" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="OuterGlow" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#10b981" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Container" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль комбобокса (ПОЛНЫЙ ШАБЛОН) -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="6"
                        Background="#27272a"
                        BorderBrush="#3f3f46"
                        BorderThickness="1" />
                <Path x:Name="Arrow" 
                      Grid.Column="1" 
                      Fill="#10b981"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Data="M0,0 L4,4 L8,0 Z"/>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#f4f4f5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" /> 
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#27272a"
                                            BorderThickness="1"
                                            BorderBrush="#3f3f46"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
               <Setter.Value>
                   <Style TargetType="ComboBoxItem">
                       <Setter Property="Background" Value="#27272a"/>
                       <Setter Property="Foreground" Value="White"/>
                       <Setter Property="BorderThickness" Value="0"/>
                       <Setter Property="Padding" Value="5"/>
                       <Setter Property="Template">
                           <Setter.Value>
                               <ControlTemplate TargetType="ComboBoxItem">
                                   <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                       <ContentPresenter />
                                   </Border>
                                   <ControlTemplate.Triggers>
                                       <Trigger Property="IsMouseOver" Value="True">
                                           <Setter TargetName="Bd" Property="Background" Value="#10b981"/>
                                       </Trigger>
                                       <Trigger Property="IsSelected" Value="True">
                                           <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                                       </Trigger>
                                   </ControlTemplate.Triggers>
                               </ControlTemplate>
                           </Setter.Value>
                       </Setter>
                   </Style>
               </Setter.Value>
           </Setter>
        </Style>

        <!-- Стиль кнопок слайдера -->
        <Style x:Key="SliderButtonStyle" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#10b981" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ползунка слайдера -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#10b981" Stroke="#059669" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#10b981" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль слайдера (Зеленый) -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#10b981"/> <!-- Emerald-500 -->
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Background="#27272a" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль прогрессбара (Зеленый) -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#10b981"/> <!-- Emerald-500 -->
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
        </Style>

        <!-- Кастомный скроллбар (Dark Emerald) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                                    CornerRadius="5"
                                                                    Background="#3f3f46"
                                                                    BorderThickness="0"
                                                                    Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#10b981"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#059669"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== CUSTOM DARK TITLE BAR ===== -->
        <Border Grid.Row="0"
                Grid.ZIndex="2"
                Background="#111113"
                BorderBrush="#2a2a2e"
                BorderThickness="0,0,0,1"
                WindowChrome.IsHitTestVisibleInChrome="False">
            <Grid>
                <!-- Drag Region -->
                <Border Background="Transparent"
                        WindowChrome.IsHitTestVisibleInChrome="False"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        HorizontalAlignment="Stretch"/>

                <!-- App Icon + Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="False">
                    <Image Source="icon.png" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="KVANT Launcher"
                               Foreground="#71717a"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblVersion" Text="v1.2.0 Alpha"
                               Foreground="#3f3f46"
                               FontSize="10"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Caption Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize"
                            Content="─"
                            Click="BtnMinimize_Click"
                            Width="46" Height="36"
                            Background="Transparent"
                            Foreground="#a1a1aa"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#a1a1aa"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#27272a"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Maximize/Restore -->
                    <Button x:Name="BtnMaximize"
                            Content="□"
                            Click="BtnMaximize_Click"
                            Width="46" Height="36"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#a1a1aa"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#27272a"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Close -->
                    <Button x:Name="BtnClose"
                            Content="✕"
                            Click="BtnClose_Click"
                            Width="46" Height="36"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#a1a1aa"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#e81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Background Area (Live Background) -->
        <!-- RowSpan=2 чтобы фон занимал полное окно и был виизуально центрирован -->
        <Border x:Name="BackgroundElements" Background="#09090b"
                Grid.Row="0" Grid.RowSpan="2" Grid.ZIndex="0">
            <Grid x:Name="BgContainer">
                <Grid x:Name="MovingBgLayer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="BgTranslate" X="0" Y="0"/>
                    </Grid.RenderTransform>
                    <!-- Generated Background Image (Scale it up a bit for movement) -->
                    <Image Source="bg_minecraft_launcher.png" Stretch="UniformToFill" Opacity="0.4">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Image.LayoutTransform>
                    </Image>
                    
                    <!-- Dark Overlay Gradient -->
                    <Border Background="#18181b" Opacity="0.6"/>
                </Grid>

                <!-- Central Content View (Dynamic) -->
                <Grid x:Name="ContentView" Margin="0,36,0,110">
                    <!-- Home View (Default) -->
                    <Grid x:Name="HomeView" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="icon.png" Width="160" Height="160" Opacity="0.6"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased">
                                <Image.Effect>
                                    <DropShadowEffect Color="#10b981" BlurRadius="60" ShadowDepth="0" Opacity="0.5"/>
                                </Image.Effect>
                            </Image>
                            <!-- Текст версии перенесен в настройки -->
                        </StackPanel>
                    </Grid>

                    <!-- Screenshot Gallery View -->
                    <Grid x:Name="GalleryView" Visibility="Collapsed" Background="#CC18181b">
                        <Border Margin="40" Background="#27272a" CornerRadius="20" BorderBrush="#3f3f46" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="ГАЛЕРЕЯ СКРИНШОТОВ" Foreground="#10b981" FontSize="20" FontWeight="Bold" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Button Content="✕" Click="CloseSubViews_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Style="{StaticResource SecondaryButtonStyle}" Width="35" Height="35"/>
                                <ScrollViewer Margin="20,60,20,20">
                                    <WrapPanel x:Name="ScreenshotsPanel" ItemWidth="200" ItemHeight="140"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Full Screen Screenshot Viewer Overlay -->
                    <Grid x:Name="ScreenshotViewerOverlay" Visibility="Collapsed" Background="#F0000000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Top Bar of Viewer -->
                        <Grid Grid.Row="0" Background="#27272a" Height="60">
                            <TextBlock x:Name="TxtScreenshotName" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Content="🗑" Style="{StaticResource SecondaryButtonStyle}" Width="40" Height="40" FontSize="20" Margin="0,0,10,0" Click="BtnViewDelete_Click" Foreground="#ef4444" ToolTip="Удалить скриншот"/>
                                <Button Content="📋" Style="{StaticResource SecondaryButtonStyle}" Width="40" Height="40" FontSize="20" Margin="0,0,10,0" Click="BtnViewCopy_Click" Foreground="#10b981" ToolTip="Копировать в буфер обмена"/>
                                <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Width="40" Height="40" FontSize="20" Click="BtnCloseViewer_Click" ToolTip="Закрыть"/>
                            </StackPanel>
                        </Grid>

                        <!-- Main Viewing Area -->
                        <ScrollViewer x:Name="ScreenShotViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" SizeChanged="ScreenShotViewer_SizeChanged">
                            <Grid x:Name="ViewerContainer" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                <Image x:Name="ImgViewer" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- Zoom Controls -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" Background="#CC27272a" CornerRadius="20" Padding="15,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="МАСШТАБ:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10"/>
                                <Slider x:Name="SliderZoom" Width="200" Minimum="0.2" Maximum="3" Value="1" 
                                        ValueChanged="SliderZoom_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Value, ElementName=SliderZoom, StringFormat={}{0:P0}}" 
                                           Foreground="White" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>

            </Grid>
        </Border>

        <!-- Main Bar (Bottom Bar) -->
        <Border x:Name="MainBar" VerticalAlignment="Bottom" Height="110" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Grid.Row="1">
            <Grid MaxWidth="1100" Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Left Buttons (Folder, Settings) -->
                    <!-- Выпадающее меню папок -->
                    <Button x:Name="BtnFolderMenu" 
                            Content="📁" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Width="45" Height="45" 
                            FontSize="18" 
                            Margin="0,0,10,0"
                            ToolTip="Папки Minecraft"
                            Click="BtnFolderMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FolderContextMenu" 
                                        Background="#27272a" 
                                        BorderBrush="#3f3f46">
                                <MenuItem Header="📸 Скриншоты" 
                                         Click="OpenScreenshotsFolder_Click"
                                         Foreground="White"
                                         Background="#27272a"/>
                                <MenuItem Header="🧩 Моды" 
                                         Click="OpenModsFolder_Click"
                                         Foreground="White"
                                         Background="#27272a"/>
                                <MenuItem Header="🔄 Вернуть отключённые моды" 
                                         Click="RestoreDisabledMods_Click"
                                         Foreground="#10b981"
                                         Background="#27272a"/>
                                <MenuItem Header="✨ Шейдеры" 
                                         Click="OpenShadersFolder_Click"
                                         Foreground="White"
                                         Background="#27272a"/>
                                <Separator Background="#3f3f46"/>
                                <MenuItem Header="📂 Главная папка" 
                                         Click="BtnFolder_Click"
                                         Foreground="White"
                                         Background="#27272a"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="⚙" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Width="45" Height="45" 
                            FontSize="22" 
                            Click="BtnSettings_Click"
                            ToolTip="Настройки"
                            Margin="0,0,10,0"/>

                    <Button Content="🖼" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Width="45" Height="45" 
                            FontSize="20" 
                            Click="BtnGallery_Click"
                            ToolTip="Галерея скриншотов"
                            Margin="0,0,10,0"/>

                    <Button x:Name="BtnServer"
                            Content="🌐" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Width="45" Height="45" 
                            FontSize="20" 
                            Click="BtnServer_Click"
                            ToolTip="Сетевая игра / Серверы"
                            Margin="0,0,10,0"/>

                    
                    <Separator Width="1" Height="40" Background="#3f3f46" Margin="20,0"/>

                    <!-- User Input & Skin -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <!-- Skin Preview -->
                        <Grid Margin="0,0,15,0">
                            <Button x:Name="BtnSkin"
                                    Style="{StaticResource SkinButtonStyle}"
                                    Tag="{Binding ElementName=ImgSkinHead, Path=Source}"
                                    Click="BtnSelectSkin_Click" 
                                    ToolTip="Сменить скин">
                                <!-- Скрытый элемент для хранения источника изображения -->
                                <Image x:Name="ImgSkinHead" Source="" Visibility="Collapsed"/>
                            </Button>

                            <!-- Кнопка сброса (x) -->
                            <Button x:Name="BtnResetSkin"
                                    Width="18" Height="18"
                                    VerticalAlignment="Top" 
                                    HorizontalAlignment="Right"
                                    Margin="0,-3,-3,0"
                                    Click="BtnResetSkin_Click"
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="9" Background="#ef4444" BorderBrush="#18181b" BorderThickness="1.5">
                                            <TextBlock Text="×" Foreground="White" FontSize="11" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="НИКНЕЙМ" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtNickname" Text="Player" Width="180" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="АККАУНТ" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Button x:Name="BtnLogin" Content="ВОЙТИ" Width="80" Height="30" FontSize="11" Click="BtnLogin_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version Select -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ВЕРСИЯ" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="ComboVersions" Width="220" Height="35" VerticalContentAlignment="Center"
                                  MaxDropDownHeight="280">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                      Padding="{TemplateBinding Padding}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="#27272a" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="10,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="▲" Foreground="#10b981" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Margin="10,0,25,0" VerticalAlignment="Center"/>
                                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                               Placement="Top" AllowsTransparency="True" Focusable="False"
                                               PopupAnimation="Slide">
                                            <Border Background="#1e1e21" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="8"
                                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                                </Border.Effect>
                                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Big Central Play Button -->
                <Button x:Name="BtnPlay" 
                        Grid.Column="1"
                        Content="ЗАПУСТИТЬ" 
                        Click="BtnPlay_Click" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Width="180" Height="60" 
                        FontSize="20"
                        Margin="20,0,0,0">
                    <Button.Effect>
                        <DropShadowEffect Color="#10b981" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>

        <!-- Progress/Status Area (Floating above the bar) -->
        <StackPanel x:Name="FooterPanel" VerticalAlignment="Bottom" Margin="0,0,0,105" HorizontalAlignment="Center" Width="600" Grid.Row="1">
            <TextBlock x:Name="TxtStatus" Text="Готов к работе" Foreground="#d4d4d8" HorizontalAlignment="Center" Margin="0,0,0,5" FontSize="12"/>
            <ProgressBar x:Name="PbStatus" Height="4" Background="#18181b" Foreground="#10b981" BorderThickness="0"/>
        </StackPanel>

        <!-- Auth Choice Overlay -->
        <Grid x:Name="AuthOverlay" Background="#CC0f0f12" Visibility="Collapsed" Grid.Row="1" Grid.ZIndex="100">
            <Border Background="#27272a" CornerRadius="20" BorderBrush="#3f3f46" BorderThickness="1" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Padding="30">
                <Grid>
                    <!-- Панель выбора (не залогинен) -->
                    <StackPanel x:Name="AuthChoicePanel">
                        <TextBlock Text="ВЫБОР СПОСОБА ВХОДА" Foreground="#10b981" FontSize="18" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>
                        
                        <Button x:Name="BtnMicrosoftAuth" Content="Microsoft Account (Лицензия)" Height="50" Margin="0,0,0,10" Click="BtnMicrosoftAuth_Click" Background="#2b579a">
                            <Button.ToolTip>Вход через официальный сайт Minecraft/Microsoft</Button.ToolTip>
                        </Button>
                        
                        <Button x:Name="BtnElyAuth" Content="Ely.by Account (Скины)" Height="50" Margin="0,0,0,10" Click="BtnShowElyLogin_Click" Background="#3b82f6">
                            <Button.ToolTip>Вход через систему скинов Ely.by (бесплатно)</Button.ToolTip>
                        </Button>
                        
                        <Button x:Name="BtnOfflineAuth" Content="Обычный режим (Ник)" Height="50" Margin="0,0,0,20" Click="BtnOfflineAuth_Click" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.ToolTip>Локальный режим без пароля (для пиратских серверов)</Button.ToolTip>
                        </Button>

                        <Button Content="ЗАКРЫТЬ" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BtnLoginClose_Click" Opacity="0.5"/>
                    </StackPanel>

                    <!-- Панель управления аккаунтом (залогинен) -->
                    <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                        <TextBlock x:Name="TxtLoggedInAs" Text="ВЫ ВОШЛИ КАК" Foreground="#10b981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtLoggedInName" Text="" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtLoggedInType" Text="" Foreground="#a1a1aa" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                        <Button Content="СМЕНИТЬ АККАУНТ" Height="50" Margin="0,0,0,10" Click="BtnSwitchAccount_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="ВЫЙТИ ИЗ АККАУНТА" Height="50" Margin="0,0,0,20" Click="BtnLogout_Click" Background="#7f1d1d" Foreground="#fca5a5"/>
                        <Button Content="ЗАКРЫТЬ" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BtnLoginClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings Overlay (Full Screen Modern Style) -->
        <Grid x:Name="SettingsOverlay" Background="#0f0f12" Visibility="Collapsed" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#18181b" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
                <Grid Margin="40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="icon.png" Width="32" Height="32" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="НАСТРОЙКИ" Foreground="#10b981" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.2.0 Alpha" Foreground="#10b981" FontSize="12" VerticalAlignment="Bottom" Margin="15,0,0,4" Opacity="0.5"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnSettings_Click" Width="40" Height="40" Padding="0" FontSize="18"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="40,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Main Settings -->
                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <Border Background="#18181b" CornerRadius="12" Padding="25" BorderBrush="#27272a" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ПРОИЗВОДИТЕЛЬНОСТЬ" Foreground="#10b981" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                                <TextBlock Text="ВЫДЕЛЕНИЕ ПАМЯТИ (RAM)" Foreground="#a1a1aa" Margin="0,0,0,10" FontSize="11" FontWeight="SemiBold"/>
                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderRAM"
                                            Grid.Column="0"
                                            Minimum="512"
                                            Maximum="4096"
                                            Value="2048"
                                            TickFrequency="512"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="0,0,20,0"
                                            ValueChanged="SliderRAM_ValueChanged"/>
                                    <TextBlock x:Name="TxtRAM"
                                               Grid.Column="1"
                                               Text="2048 MB"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               MinWidth="100"
                                               TextAlignment="Right"/>
                                </Grid>

                                <CheckBox x:Name="CheckFastLaunch"
                                          Content="Быстрый запуск (пропускать проверку целостности файлов)"
                                          Margin="0,0,0,10"
                                          IsChecked="True"/>

                                <Button Content="АВТОМАТИЧЕСКАЯ ОПТИМИЗАЦИЯ"
                                        Click="BtnOptimize_Click"
                                        Background="#047857"
                                        Height="45"
                                        Margin="0,20,0,0"
                                        ToolTip="Лаунчер сам подберет лучшие настройки под ваше железо"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18181b" CornerRadius="12" Padding="25" BorderBrush="#27272a" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="О ПРОГРАММЕ" Foreground="#10b981" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                                <TextBlock Text="KVANT Launcher — свободный лаунчер для Minecraft, созданный с любовью к сообществу."
                                           Foreground="#a1a1aa" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                <Button Content="ПОДРОБНЕЕ / ПОДДЕРЖАТЬ АВТОРА"
                                        Click="BtnAbout_Click"
                                        Height="45"
                                        Background="#047857"
                                        FontSize="13"
                                        ToolTip="Информация о программе и способы поддержки"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Versions & Behavior -->
                    <StackPanel Grid.Column="1">
                        <Border Background="#18181b" CornerRadius="12" Padding="25" BorderBrush="#27272a" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ОТОБРАЖЕНИЕ ВЕРСИЙ" Foreground="#10b981" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                                <CheckBox x:Name="CheckShowModded"
                                          Content="Forge / NeoForge / Fabric / OptiFine"
                                          Margin="0,0,0,18"
                                          IsChecked="True"
                                          Checked="VersionFilter_Changed"
                                          Unchecked="VersionFilter_Changed"/>

                                <CheckBox x:Name="CheckShowSnapshots"
                                          Content="Серии Snapshot"
                                          Margin="0,0,0,18"
                                          Checked="VersionFilter_Changed"
                                          Unchecked="VersionFilter_Changed"/>

                                <CheckBox x:Name="CheckShowOld"
                                          Content="Alpha и Beta версии"
                                          Margin="0,0,0,0"
                                          Checked="VersionFilter_Changed"
                                          Unchecked="VersionFilter_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#18181b" CornerRadius="12" Padding="25" BorderBrush="#27272a" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ПОВЕДЕНИЕ ЛАУНЧЕРА" Foreground="#10b981" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                                <TextBlock Text="ПОСЛЕ ЗАПУСКА ИГРЫ" Foreground="#a1a1aa" Margin="0,0,0,10" FontSize="11" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ComboLauncherBehavior" Height="40" VerticalContentAlignment="Center" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Закрыть KVANT Launcher"/>
                                    <ComboBoxItem Content="Свернуть в трей"/>
                                    <ComboBoxItem Content="Ничего не делать"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Button Content="СОХРАНИТЬ ВСЁ"
                                Click="BtnSettings_Click"
                                Height="50"
                                FontSize="16"
                                FontWeight="Bold"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <!-- About Overlay -->
        <Grid x:Name="AboutOverlay" Background="#0f0f12" Visibility="Collapsed" Grid.Row="1" Grid.ZIndex="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#18181b" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
                <Grid Margin="40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="icon.png" Width="32" Height="32" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="О ПРОГРАММЕ" Foreground="#10b981" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnAbout_Close_Click" Width="40" Height="40" Padding="0" FontSize="18"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="40,30" MaxWidth="900" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: About Info -->
                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <Border Background="#18181b" CornerRadius="12" Padding="30" BorderBrush="#27272a" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Image Source="icon.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,20,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="KVANT Launcher" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="v1.2.0 Alpha" Foreground="#10b981" FontSize="14" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#27272a" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                                    <StackPanel>
