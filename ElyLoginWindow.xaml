<Window x:Class="KVANTLauncher.ElyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход Ely.by" Height="450" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Opacity="0">

    <Border x:Name="RootBorder" Background="#18181b" CornerRadius="20" BorderBrush="#3f3f46" BorderThickness="1" MouseDown="Border_MouseDown"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Direction="0" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>
        <Grid Margin="30">
            <!-- Кнопка закрытия в углу -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,-10,-10,0" Width="30" Height="30" 
                    Background="Transparent" Foreground="#a1a1aa" BorderThickness="0"
                    FontSize="16" Cursor="Hand" Click="BtnCancel_Click"/>

            <StackPanel>
                <TextBlock Text="ELY.BY" Foreground="#3b82f6" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="АВТОРИЗАЦИЯ" Foreground="#3b82f6" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.8"/>
                <TextBlock Text="Введите данные от вашего аккаунта" Foreground="#a1a1aa" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="EMAIL ИЛИ НИК" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEmail" Height="45" Background="#27272a" Foreground="White" BorderBrush="#3f3f46" BorderThickness="1" VerticalContentAlignment="Center" Padding="10,0"/>

                <TextBlock Text="ПАРОЛЬ" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold" Margin="5,15,0,5"/>
                <PasswordBox x:Name="TxtPassword" Height="45" Background="#27272a" Foreground="White" BorderBrush="#3f3f46" BorderThickness="1" VerticalContentAlignment="Center" Padding="10,0"/>

                <Button x:Name="BtnLogin" Content="ВОЙТИ В АККАУНТ" Height="50" Margin="0,30,0,10" Click="BtnLogin_Click" Background="#3b82f6" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="ОТМЕНА" Height="40" Click="BtnCancel_Click" Background="Transparent" Foreground="#a1a1aa" BorderThickness="0"/>
            </StackPanel>
            
            <!-- Индикатор загрузки -->
            <Grid x:Name="LoadingGrid" Background="#CC18181b" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Проверка данных..." Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
